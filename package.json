{
  "name": "bps-mcp-server",
  "version": "0.19.0",
  "description": "MCP server for BPS (Badan Pusat Statistik) Indonesia statistics data",
  "author": "Murphi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setiapam/bps-mcp-server.git"
  },
  "homepage": "https://github.com/setiapam/bps-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/setiapam/bps-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "bps-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file=.env dist/index.js",
    "start:code": "node --env-file=.env dist/index.js --code-mode",
    "start:http": "node --env-file=.env dist/http-server.js",
    "dev:http": "node --watch --env-file=.env dist/http-server.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit --project tsconfig.worker.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "quickjs-emscripten": "^0.32.0",
    "stopwords-iso": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "bps",
    "statistics",
    "indonesia",
    "model-context-protocol",
    "ai",
    "claude",
    "data"
  ]
}
